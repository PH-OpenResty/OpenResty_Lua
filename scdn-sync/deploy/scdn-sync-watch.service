[Unit]
Description=SCDN isolated Master site file watcher and encrypted publisher
After=local-fs.target

[Service]
Type=simple
User=scdn-sync-master
Group=scdn-sync-master
UMask=0077
ExecStart=/usr/local/openresty/bin/resty -I /opt/scdn-sync/lib /opt/scdn-sync/bin/watch.lua /etc/scdn-sync/master-watch.lua
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scdn-sync-master
LimitNOFILE=2048
TasksMax=32
MemoryMax=512M

[Install]
WantedBy=multi-user.target
