[Unit]
Description=SCDN independent OpenResty ciphertext distributor
After=network.target scdn-sync-writer.service

[Service]
Type=simple
User=scdn-sync-master
Group=scdn-sync-master
UMask=0077
RuntimeDirectory=scdn-sync-master-distributor
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStart=/usr/local/openresty/nginx/sbin/nginx -p /run/scdn-sync-master-distributor/ -e stderr -c /opt/scdn-sync/conf/master-distributor.nginx.conf -g "daemon off;"
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/scdn-sync-master-distributor
LimitNOFILE=8192
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
